# Copy this file to server/.env and fill in what you need.
# You only need to configure the providers you plan to use.
# NEVER put real keys in this file: it is a template that gets committed and shared.

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
PORT=3001
# 127.0.0.1 keeps the API (and your API keys) private to this machine.
# Use 0.0.0.0 when hosting (Railway, Docker...): that requires ACCESS_TOKENS below.
HOST=127.0.0.1
# Only needed if the frontend is served from a different origin
# (comma-separated list). Not needed with the Vite dev proxy.
CORS_ORIGIN=

# ---------------------------------------------------------------
# Access control (required when hosting)
# ---------------------------------------------------------------
# Comma-separated access tokens, 16+ characters each. When set, every /api route
# except /api/health needs "Authorization: Bearer <token>", and the web UI asks
# for a token once. Use one token per person/project so each can be revoked.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# The server refuses to start on a public HOST (e.g. 0.0.0.0) without tokens.
ACCESS_TOKENS=
# Set to true only if your own auth (proxy, VPN...) already protects the server.
ALLOW_NO_AUTH=

# ---------------------------------------------------------------
# Agent
# ---------------------------------------------------------------
# Provider selected by default in the UI: ollama | anthropic | openai | grok | groq
# (blank = first configured provider)
DEFAULT_PROVIDER=
AGENT_SYSTEM_PROMPT=You are a helpful, concise assistant. Answer clearly and use Markdown when it helps.
# Only the most recent N messages are sent to the model.
AGENT_MAX_HISTORY=40

# ---------------------------------------------------------------
# Ollama (local models, no key needed; not available when hosted)
# ---------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
# Blank = use the first model installed in Ollama (`ollama list`)
OLLAMA_MODEL=
# Only for a remote/hosted Ollama that requires a bearer token
OLLAMA_API_KEY=
# Thinking models (qwen3, deepseek-r1, gpt-oss...): true | false | low | medium | high
# Blank = model default. Only the final answer is shown in the chat.
OLLAMA_THINK=

# ---------------------------------------------------------------
# Claude (Anthropic)  https://platform.claude.com
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Hard cap on output tokens (thinking + answer).
ANTHROPIC_MAX_TOKENS=16000
# Optional thinking effort: low | medium | high | xhigh | max (blank = model default)
ANTHROPIC_EFFORT=
# Optional: route through a gateway/proxy
ANTHROPIC_BASE_URL=

# ---------------------------------------------------------------
# OpenAI  https://platform.openai.com
# ---------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol
# Optional output token cap (blank = model default)
OPENAI_MAX_TOKENS=
# "responses" (OpenAI's recommended API) or "chat" (Chat Completions).
# Use "chat" when OPENAI_BASE_URL points at an OpenAI-compatible server
# such as OpenRouter, LM Studio or vLLM.
OPENAI_API_MODE=responses
OPENAI_BASE_URL=

# ---------------------------------------------------------------
# Grok (xAI)  https://console.x.ai   (keys start with "xai-")
# ---------------------------------------------------------------
XAI_API_KEY=
XAI_MODEL=grok-4.7
# Optional output token cap (blank = model default)
XAI_MAX_TOKENS=
# Optional reasoning effort, e.g. low | medium | high (supported values depend on the model; blank = model default)
XAI_REASONING_EFFORT=
# Blank = https://api.x.ai/v1
XAI_BASE_URL=

# ---------------------------------------------------------------
# Groq (GroqCloud, fast open models)  https://console.groq.com   (keys start with "gsk_")
# Not the same as Grok above. A key placed under the wrong one is detected and moved.
# ---------------------------------------------------------------
GROQ_API_KEY=
# e.g. openai/gpt-oss-120b, openai/gpt-oss-20b, llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=openai/gpt-oss-120b
# Optional output token cap (blank = model default)
GROQ_MAX_TOKENS=
# Optional, gpt-oss models only: low | medium | high (blank = model default)
GROQ_REASONING_EFFORT=
# Blank = https://api.groq.com/openai/v1
GROQ_BASE_URL=
